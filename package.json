{
  "name": "church-history-map",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "dev": "pnpm data && vite",
    "build": "pnpm data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "fetch:geo": "tsx scripts/fetch-geo.ts",
    "i18n:report": "tsx scripts/i18n-report.ts",
    "links": "tsx scripts/link-check.ts",
    "check:pleiades": "tsx scripts/check-pleiades.ts"
  },
  "dependencies": {
    "i18next": "^26.4.4",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
